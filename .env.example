# Revengers CQA — environment template. Copy to `.env` (never committed) and adjust.
# The server reads `.env` itself at start-up; every variable is optional and has the default shown.

# ---------------------------------------------------------------- server
# HTTP port for the UI + REST API (open http://localhost:8080).
PORT=8080

# ---------------------------------------------------------------- data source
# Organizers' Power Automate endpoint WITHOUT `group_id`; the server appends `&group_id=<DEV|control>` per request.
# Every successful fetch is cached in data/raw/<group_id>.json, so the UI keeps working offline.
CQA_DATA_URL=https://ec88f21f1accecf38e20095a9fe175.a5.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/11/workflows/b3d2a68006a24662be2b721454cb4e00/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=5Sog2MThgCRTlk3HObv70LRmRk6u7IOwzlwMpe804qo

# ---------------------------------------------------------------- evaluator provider selection
# Empty = automatic: alem (if ALEM_* set and reachable) -> ollama (if running) -> offline (cached results only).
# Explicit values: alem | ollama | openai (any OpenAI-compatible endpoint) | anthropic | offline.
CQA_PROVIDER=
# Parallel judge calls. 2 is right for a free tier / a 6 GB GPU.
CQA_CONCURRENCY=2
# Paid cloud providers (anthropic) stay in the code but are LOCKED unless this is 1.
CQA_ALLOW_CLOUD=0

# ---------------------------------------------------------------- alem.plus (preferred free provider, OpenAI-compatible)
# Base URL of the OpenAI-compatible API and your key — both from your alem.plus account.
ALEM_BASE_URL=
ALEM_API_KEY=
# Model ids are taken from the platform's model list; roles are described in docs/ARCHITECTURE.md.
# Judge: the main evaluator (Qwen 3.8 family id as listed by the platform).
ALEM_MODEL_JUDGE=
# Verifier: audits the judge; use a DIFFERENT model family (e.g. a GPT-OSS or Gemma 4 id).
ALEM_MODEL_VERIFIER=
# Kazakh second opinion for KZ dialogs (KazLLM id).
ALEM_MODEL_KZ=
# Fallback when the judge is unavailable (AlemLLM id).
ALEM_MODEL_FALLBACK=
# Optional: embeddings (similar-case lookup for appeals) and reranking.
ALEM_EMBED_MODEL=
ALEM_RERANK_MODEL=

# ---------------------------------------------------------------- Ollama (offline / local fallback)
# `ollama pull qwen2.5:7b` once; the server talks to the OpenAI-compatible endpoint <OLLAMA_BASE_URL>/v1.
OLLAMA_BASE_URL=http://localhost:11434
# Generic OpenAI-compatible settings, used when CQA_PROVIDER=openai (defaults point at Ollama).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=ollama

# ---------------------------------------------------------------- paid cloud (locked by CQA_ALLOW_CLOUD=0)
CQA_MODEL=claude-sonnet-5-5
CQA_VERIFIER_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional observability (off by default)
# LLM call tracing. Leave empty to disable; nothing is sent anywhere when unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------- optional
# Timeout for the organizers' API, ms.
CQA_FETCH_TIMEOUT_MS=30000
# Where raw datasets, the evaluation database and the evaluator cache live (default: ./data).
# CQA_DATA_DIR=./data

# ---------------------------------------------------------------- optional external APIs behind a HARD spending guard
# Every request is checked against a local ledger (data/budget/<provider>.json) BEFORE it is sent: the worst case of the
# next call (input + max_tokens at list price) must stay under <P>_MAX_USD, and calls per UTC day under <P>_MAX_CALLS_PER_DAY.
# A refused request is never retried; the evaluator falls back to deterministic rules and says so. Use with CQA_PROVIDER=gemini|nvidia.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_CALLS_PER_DAY=200
GEMINI_MAX_USD=0.50
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_MAX_USD=35
NVIDIA_MAX_CALLS_PER_DAY=300
